{%- comment -%} "Want it by Christmas?" line (Nov 2026). Dates: USPS 2026 holiday send-by dates (Ground Advantage Dec 17, Priority Dec 18) minus a day,
  because orders ship the next business day; Media Mail (free/economy shipping) has no USPS date, so it uses up to 8 business days plus a holiday buffer.
  Shows only until Dec 24 and only the options still in time. {%- endcomment -%}
<p class="tme-xmas" data-tme-xmas hidden></p>
<script>
(() => { document.querySelectorAll('[data-tme-xmas]:not([data-done])').forEach(el => { el.dataset.done = 1;
  const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/New_York' })); const y = now.getFullYear(); if (now.getMonth() !== 10 && now.getMonth() !== 11) return;
  const D = (m, d) => new Date(y, m, d, 23, 59); const opts = [['free or economy shipping', D(11, 9)], ['Ground Advantage', D(11, 15)], ['Priority Mail', D(11, 16)]].filter(o => now <= o[1]); if (!opts.length) return;
  const f = d => d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  const parts = opts.map(o => `<b>${f(o[1])}</b> with ${o[0]}`); el.innerHTML = '🎄 <b>Want it by Christmas?</b> Order by ' + (parts.length > 1 ? parts.slice(0, -1).join(', ') + ', or ' + parts[parts.length - 1] : parts[0]) + '.';
  el.hidden = false; }); })();
</script>
<style>.tme-xmas{margin:10px 0;padding:8px 12px;border-radius:10px;background:#eaf6ec;border:1px solid #b9dfc0;font-size:14px}</style>

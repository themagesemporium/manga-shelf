{%- comment -%} Wishlist page (/pages/wishlist): the customer's one list, shared with the My Manga Emporium app. {%- endcomment -%}
<div class="tme-wlp">
  <h1 class="tme-wlp-h">{{ page.title | default: 'My Wishlist' }}</h1>
  {%- if customer -%}
    <p class="tme-wlp-sub">This is the same list as the ♥ Wishlist in the <a href="https://app.themagesemporium.com">My Manga Emporium app</a>. Heart a book in either place and it shows up in both.</p>
    <fieldset class="tme-wlp-pref"><legend>Email me when something comes back in stock or drops 10% or more</legend>
      <label><input type="radio" name="tme-wl-pref" value="hourly"> Within the hour <span>(recommended)</span></label>
      <label><input type="radio" name="tme-wl-pref" value="daily"> One summary a day</label>
      <label><input type="radio" name="tme-wl-pref" value="off"> No emails</label>
    </fieldset>
  {%- else -%}
    <p class="tme-wlp-sub">Hearts you add are saved on this device. <a href="{{ routes.account_login_url }}">Sign in</a> to keep your wishlist everywhere (including the My Manga Emporium app) and get an email when a book comes back in stock or goes on sale.</p>
  {%- endif -%}
  <div class="tme-wlp-tools"><label>Show <select id="tme-wl-show"><option value="all">Everything</option><option value="in">In stock now</option></select></label></div>
  <div id="tme-wl-list" class="tme-wlp-list"><p>Loading your wishlist…</p></div>
</div>
<style>
  .tme-wlp{max-width:900px}
  .tme-wlp-sub{margin:4px 0 12px}
  .tme-wlp-pref{border:1px solid rgba(0,0,0,.15);border-radius:8px;padding:8px 12px;margin:0 0 14px}
  .tme-wlp-pref label{display:block;margin:4px 0;cursor:pointer}.tme-wlp-pref span{opacity:.7;font-size:.9em}
  .tme-wlp-tools{margin:0 0 10px}
  .tme-wlp-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}
  .tme-wlc{position:relative;background:#fff;border-radius:8px;padding:8px;box-shadow:0 1px 3px rgba(0,0,0,.12);display:flex;flex-direction:column;gap:4px;font-size:14px}
  .tme-wlc img{width:100%;aspect-ratio:2/3;object-fit:contain;background:#f6f6f6;border-radius:4px}
  .tme-wlc a{color:inherit;text-decoration:none;font-weight:600}
  .tme-wlc .p{font-weight:700}.tme-wlc .in{color:#2f7d4f;font-size:12px;font-weight:700}.tme-wlc .out{opacity:.65;font-size:12px}
  .tme-wlc .x{position:absolute;top:4px;right:4px;width:28px;height:28px;border-radius:50%;border:0;background:rgba(255,255,255,.9);box-shadow:0 1px 3px rgba(0,0,0,.25);cursor:pointer;font-size:16px;line-height:28px}
  .tme-wlp-empty{grid-column:1/-1}
</style>
<script>
function tmeWlPage(){
  var box = document.getElementById('tme-wl-list'), show = document.getElementById('tme-wl-show'), cache = {};
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function money(c){ return '$' + (c / 100).toFixed(2); }
  function look(it){ var k = TMEWL.key(it); if (cache[k]) return cache[k];
    var p = it.h ? fetch('/products/' + encodeURIComponent(it.h) + '.js').then(function(r){ return r.ok ? r.json() : null; }) : Promise.resolve(null);
    return cache[k] = p.then(function(pr){ if (pr) return pr; if (!it.s) return null;
      var q = it.s + ' vol ' + it.v + (it.ln ? ' light novel' : '');
      return fetch('/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=6').then(function(r){ return r.json(); }).then(function(j){
        var ps = (j.resources && j.resources.results && j.resources.results.products) || [], re = new RegExp('\\bvol(?:ume)?\\.?\\s*0*' + Math.round(it.v) + '\\b', 'i');
        var hit = ps.find(function(x){ return re.test(x.title) && (!!it.ln === /novel/i.test(x.title + ' ' + (x.type || ''))); }) || ps.find(function(x){ return re.test(x.title); });
        return hit ? fetch(hit.url.split('?')[0] + '.js').then(function(r){ return r.ok ? r.json() : null; }) : null; }); }).catch(function(){ return null; }); }
  function draw(W){ var items = (W.items || []).slice().sort(function(a, b){ return String(a.s || a.t).localeCompare(String(b.s || b.t)) || (a.v || 0) - (b.v || 0); });
    if (show && W.prefs) document.querySelectorAll('[name=tme-wl-pref]').forEach(function(r){ r.checked = r.value === (W.prefs.email || 'hourly'); });
    if (!items.length){ box.innerHTML = '<p class="tme-wlp-empty">Your wishlist is empty. Tap <b>Add to Wishlist</b> on any book (or ♥ in the app) to save it here.</p>'; return; }
    box.innerHTML = items.map(function(it, i){ var name = it.s ? it.s + (it.ln ? ' (Light Novel)' : '') + ' Vol ' + it.v : (it.t || 'Saved item');
      return '<div class="tme-wlc" data-i="' + i + '"><button class="x" type="button" aria-label="Remove ' + esc(name) + '" data-rm="' + i + '">✕</button><img alt="" loading="lazy"><a class="t">' + esc(name) + '</a><span class="p"></span><span class="st out">Checking…</span></div>'; }).join('');
    items.forEach(function(it, i){ var el = box.querySelector('[data-i="' + i + '"]'); el._it = it;
      look(it).then(function(pr){ if (!pr){ el.querySelector('.st').textContent = 'Not listed right now'; el.querySelector('img').src = 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 2 3%22><rect width=%222%22 height=%223%22 fill=%22%23eee%22/></svg>'; return; }
        el.querySelector('img').src = (pr.featured_image || '').replace(/^\/\//, 'https://') + (pr.featured_image ? (/\?/.test(pr.featured_image) ? '&' : '?') + 'width=300' : '');
        var a = el.querySelector('a.t'); a.href = '/products/' + pr.handle; el.querySelector('.p').textContent = money(pr.price);
        var st = el.querySelector('.st'); st.className = 'st ' + (pr.available ? 'in' : 'out'); st.textContent = pr.available ? 'In stock' : 'Out of stock: we’ll email you'; el.dataset.in = pr.available ? 1 : 0; filter(); }); }); }
  function filter(){ var only = show && show.value === 'in'; box.querySelectorAll('.tme-wlc').forEach(function(el){ el.hidden = only && el.dataset.in !== '1'; }); }
  if (show) show.onchange = filter;
  box.addEventListener('click', function(e){ var b = e.target.closest('[data-rm]'); if (!b) return; var el = b.closest('.tme-wlc'); TMEWL.toggle(el._it); });
  document.querySelectorAll('[name=tme-wl-pref]').forEach(function(r){ r.onchange = function(){ TMEWL.setPref(r.value); }; });
  TMEWL.on(draw);
}
if (window.TMEWL) tmeWlPage(); else document.addEventListener('DOMContentLoaded', tmeWlPage);
</script>

{% schema %}
{"name":"Wishlist (one list)","settings":[]}
{% endschema %}

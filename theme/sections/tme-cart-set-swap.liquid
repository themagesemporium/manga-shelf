{%- comment -%} Cart: "Swap to the set" (Nov 2026). When the cart holds 2+ singles of a Vol 1 Bundle set (single's custom.bundle_set),
  offer to replace them with the set (10% off) and add the remaining volumes. Uses the set's custom.bundle_items for the volume list.
  Skips sets that are sold out or already in the cart. Works next to cart-series-suggest ("Complete your series"). {%- endcomment -%}
{%- liquid
  assign seen = ''
  capture offers
    for item in cart.items
      assign st = item.product.metafields.custom.bundle_set.value
      if st == blank or st.available == false
        continue
      endif
      assign key = '|' | append: st.id | append: '|'
      if seen contains key
        continue
      endif
      assign seen = seen | append: key
      assign in_cart_set = false
      for x in cart.items
        if x.product.id == st.id
          assign in_cart_set = true
        endif
      endfor
      if in_cart_set
        continue
      endif
      assign comps = st.metafields.custom.bundle_items.value
      if comps == blank
        continue
      endif
      assign have = 0
      assign have_vids = ''
      assign sum = 0
      assign have_sum = 0
      for c in comps
        assign sum = sum | plus: c.price
        for x in cart.items
          if x.product.id == c.id
            assign have = have | plus: 1
            assign have_sum = have_sum | plus: x.final_line_price
            assign have_vids = have_vids | append: x.key | append: ','
          endif
        endfor
      endfor
      if have < 2 or have >= comps.size
        continue
      endif
      assign more = comps.size | minus: have
      assign save = sum | minus: st.price
      assign extra = st.price | minus: have_sum
      assign img = ''
      if st.featured_image
        assign img = st.featured_image | image_url: width: 120
      endif
      assign extra_m = extra | money
      assign price_m = st.price | money
      assign save_m = save | money
      assign t = st.title | escape
      echo '<div class="tme-swap" data-keys="' | append: have_vids | append: '" data-set="' | append: st.selected_or_first_available_variant.id | append: '">'
      if img != ''
        echo '<img src="' | append: img | append: '" alt="" width="60" height="90" loading="lazy">'
      endif
      echo '<div><b>' | append: have | append: ' of the ' | append: comps.size | append: ' books in the <a href="' | append: st.url | append: '">' | append: t | append: '</a> are in your cart.</b><br>'
      if extra > 0
        echo 'Swap them for the whole set and get the other ' | append: more | append: ' for ' | append: extra_m | append: ' more. The set is ' | append: price_m | append: ', ' | append: save_m | append: ' less than buying all ' | append: comps.size | append: ' separately.</div>'
      else
        echo 'Swap them for the whole set and get all ' | append: comps.size | append: ' books for ' | append: price_m | append: ', less than you’re paying for these ' | append: have | append: ' now.</div>'
      endif
      echo '<button type="button" class="button" data-swap>Swap to the set</button></div>'
    endfor
  endcapture
-%}
{%- if offers != blank -%}
<div class="tme-swaps page-width">
  <h2 class="tme-swap-h">📦 Get the whole set and save</h2>
  {{ offers }}
</div>
<style>
  .tme-swaps{margin:16px auto}.tme-swap-h{margin:0 0 8px;font-size:1.2em}
  .tme-swap{display:flex;gap:12px;align-items:center;flex-wrap:wrap;background:#fff7e0;border:1px solid #f0da93;border-radius:12px;padding:10px 12px;margin:0 0 10px}
  .tme-swap img{width:60px;height:90px;object-fit:contain;border-radius:4px;background:#fff}.tme-swap>div{flex:1 1 240px;font-size:14px}.tme-swap .button{white-space:nowrap}
</style>
<script>
document.querySelectorAll('.tme-swap [data-swap]').forEach(b => b.onclick = async () => { const box = b.closest('.tme-swap'); b.disabled = true; b.textContent = 'Swapping…';
  try { const updates = {}; box.dataset.keys.split(',').filter(Boolean).forEach(k => updates[k] = 0);
    let r = await fetch('/cart/add.js', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ items: [{ id: +box.dataset.set, quantity: 1 }] }) }); if (!r.ok) throw 0; // add the set first, so a sold-out set never empties the cart
    await fetch('/cart/update.js', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ updates }) }); location.reload(); }
  catch(e){ b.disabled = false; b.textContent = 'Sorry, that set just sold out'; } });
</script>
{%- endif -%}
{% schema %}
{ "name": "Swap singles for a set", "settings": [], "presets": [{ "name": "Swap singles for a set" }] }
{% endschema %}

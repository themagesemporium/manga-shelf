{%- comment -%} Holiday gift guide around the Gift Finder (Nov 2026). Two parts on page.gift-finder:
  part "top": a shared gift list (?gl=, made by the My Manga Emporium app's "Share my gift list" button) + quick-start presets that fill in the finder below.
  part "bottom": ready-made gifts (Vol 1 sets, stand-alones, mystery box, gift card) and gift tips. The finder itself stays in tme-ai-finder. {%- endcomment -%}
{%- assign part = section.settings.part | default: 'top' -%}
<div class="tme-gg" id="tme-gg-{{ section.id }}">
{%- if part == 'top' -%}
  <div class="tme-gg-list" data-gg-list hidden></div>
  <div class="tme-gg-quick">
    <p class="tme-gg-qh">Quick start: tap one and we’ll pick books right away, or answer the questions below</p>
    <div class="tme-gg-qb">
      <button type="button" data-gg-preset='{"who":"teen","chips":["Action & fights","Fantasy & magic"],"budget":40,"newbie":true}'>🧑 Teen who’s new to manga</button>
      <button type="button" data-gg-preset='{"who":"kid","chips":["Funny","Animals"],"budget":30,"newbie":true}'>🧒 Kid under 10</button>
      <button type="button" data-gg-preset='{"who":"tween","chips":["Funny","School life","Fantasy & magic"],"budget":35,"newbie":true}'>📚 Tween (10–12)</button>
      <button type="button" data-gg-preset='{"who":"adult","chips":["Cozy & wholesome"],"budget":40,"newbie":true}'>☕ Cozy reads for a grown-up</button>
      <button type="button" data-gg-preset='{"who":"adult","chips":["Romance"],"budget":40,"newbie":true}'>💕 Romance fan</button>
      <button type="button" data-gg-preset='{"who":"older","chips":["Spooky","Mystery"],"budget":40,"newbie":true}'>👻 Loves spooky stuff</button>
      <button type="button" data-gg-preset='{"who":"teen","chips":["Anime they watch"],"likes":"stand-alone books that fit in a stocking","budget":15,"newbie":true}'>🧦 Stocking stuffer under $15</button>
      <button type="button" data-gg-preset='{"who":"adult","chips":[],"likes":"already reads a lot of manga; something they probably haven’t found yet","budget":60,"newbie":false}'>🏆 Already a big manga fan</button>
    </div>
  </div>
{%- else -%}
  <h2 class="tme-gg-h">🎄 Ready-made gift ideas</h2>
  {%- assign sets = collections['vol-1-bundle-deals'].products -%}
  {%- capture setcards -%}{%- assign n = 0 -%}{%- for p in sets -%}{%- assign ar = p.metafields.custom.age_rating.value | default: '' | downcase -%}{%- if p.available and n < 8 -%}{%- unless ar contains 'mature' or p.tags contains 'Mature' -%}{%- assign n = n | plus: 1 -%}{%- render 'tme-gg-card', p: p -%}{%- endunless -%}{%- endif -%}{%- endfor -%}{%- endcapture -%}
  {%- if setcards != blank -%}
  <div class="tme-gg-shelf"><div class="tme-gg-sh"><h3>📦 Start a whole series</h3><a href="/collections/vol-1-bundle-deals">See all sets →</a></div>
    <p class="tme-gg-sub">Vol 1 and the next few volumes together, 10% off the single prices. The easiest gift for someone new to a series.</p>
    <div class="tme-gg-row">{{ setcards }}</div></div>
  {%- endif -%}
  {%- capture onecards -%}{%- assign n = 0 -%}{%- for p in collections['one-shots'].products -%}{%- assign ar = p.metafields.custom.age_rating.value | default: '' | downcase -%}{%- if p.available and p.price <= 1500 and n < 8 -%}{%- unless ar contains 'mature' or p.tags contains 'Mature' or p.title contains 'Yaoi' -%}{%- assign n = n | plus: 1 -%}{%- render 'tme-gg-card', p: p -%}{%- endunless -%}{%- endif -%}{%- endfor -%}{%- endcapture -%}
  {%- if onecards != blank -%}
  <div class="tme-gg-shelf"><div class="tme-gg-sh"><h3>🧦 Stand-alone stories under $15</h3><a href="/collections/one-shots">See all stand-alones →</a></div>
    <p class="tme-gg-sub">One book, a whole story. Great stocking stuffers, with no “what volume are they on?” guessing.</p>
    <div class="tme-gg-row">{{ onecards }}</div></div>
  {%- endif -%}
  <div class="tme-gg-tiles">
    {%- assign mb = all_products['mystery-english-manga-box'] -%}
    {%- if mb.available -%}<a class="tme-gg-tile" href="{{ mb.url }}"><span>🎲</span><b>Mystery Manga Box</b><small>We hand-pick the books. Tell us what they like and what they already own on the box’s page, and we’ll skip repeats.</small></a>{%- endif -%}
    {%- assign gc = all_products['gift-card'] -%}
    {%- if gc.available -%}<a class="tme-gg-tile" href="{{ gc.url }}"><span>💳</span><b>Gift Card</b><small>Let them pick. Sent by email and works on everything in the shop.</small></a>{%- endif -%}
    <a class="tme-gg-tile" href="https://app.themagesemporium.com" target="_blank" rel="noopener"><span>📱</span><b>Know a manga fan? Get their gift list</b><small>Readers who use our free My Manga Emporium app can tap “Share my gift list.” Their link opens here with exactly the volumes they want, ready to add to your cart.</small></a>
  </div>
  {%- render 'tme-xmas-by' -%}
  <p class="tme-gg-foot">🚚 Free shipping on orders of $35 or more. Questions about a gift? <a href="/pages/contact">Ask us</a>, we’re happy to help pick.</p>
{%- endif -%}
</div>
<style>
  .tme-gg{max-width:1000px;margin:0 auto 18px}.tme-gg-h{margin:10px 0 6px}
  .tme-gg-quick{background:#fff7e0;border:1px solid #f0da93;border-radius:12px;padding:10px 14px;margin:0 0 16px}.tme-gg-qh{margin:0 0 8px;font-weight:700}
  .tme-gg-qb{display:flex;flex-wrap:wrap;gap:6px}.tme-gg-qb button{border:1px solid rgba(0,0,0,.2);background:#fff !important;color:#222 !important;text-shadow:none;border-radius:999px;padding:7px 12px;font:inherit;font-size:14px;line-height:1.3;cursor:pointer;text-transform:none;letter-spacing:normal;min-height:0;width:auto}.tme-gg-qb button:hover,.tme-gg-qb button:focus-visible{border-color:#f0662b;outline:none;box-shadow:0 0 0 2px rgba(240,102,43,.25)}
  .tme-gg-shelf{margin:0 0 20px}.tme-gg-sh{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}.tme-gg-sh h3{margin:0}.tme-gg-sh a{font-size:14px}.tme-gg-sub{margin:4px 0 10px;opacity:.85;font-size:14px}
  .tme-gg-row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(150px,170px);gap:12px;overflow-x:auto;padding:2px 2px 8px;scroll-snap-type:x proximity}
  .tme-gg-card{scroll-snap-align:start;background:#fff;border-radius:10px;padding:8px;box-shadow:0 1px 4px rgba(0,0,0,.12);display:flex;flex-direction:column;gap:4px;font-size:13px;color:inherit;text-decoration:none}
  .tme-gg-card img{width:100%;aspect-ratio:2/3;object-fit:contain;background:#f6f6f6;border-radius:6px}.tme-gg-card b{font-size:13px;line-height:1.25}.tme-gg-card s{opacity:.6;margin-left:4px}
  .tme-gg-tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin:0 0 14px}
  .tme-gg-tile{display:flex;flex-direction:column;gap:4px;padding:12px 14px;border-radius:12px;border:1px solid rgba(0,0,0,.12);background:#fff;color:inherit;text-decoration:none}.tme-gg-tile span{font-size:26px}.tme-gg-tile small{opacity:.8;font-size:13px}
  .tme-gg-foot{font-size:14px;opacity:.9}
  .tme-gg-list{background:#fff;border:2px solid #f0662b;border-radius:14px;padding:12px 14px;margin:0 0 16px}.tme-gg-list h2{margin:0 0 4px}.tme-gg-list .tme-gg-sub{margin:0 0 10px}
  .tme-gg-lg{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
  .tme-gg-li{background:#fafafa;border-radius:10px;padding:8px;display:flex;flex-direction:column;gap:4px;font-size:13px}.tme-gg-li img{width:100%;aspect-ratio:2/3;object-fit:contain;background:#f0f0f0;border-radius:6px}.tme-gg-li a{color:inherit;text-decoration:none;font-weight:700}.tme-gg-li button{width:100%}
  .tme-gg-taste{margin:12px 0 0;padding:10px 12px;border-radius:10px;background:#fff7e0;border:1px solid #f0da93;font-size:14px}.tme-gg-taste p{margin:0 0 8px}.tme-gg-out{margin:10px 0 0;font-size:14px}.tme-gg-out summary{cursor:pointer;font-weight:600}.tme-gg-out li{margin:2px 0}.tme-gg-tot{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:12px 0 0;font-weight:600}
</style>
{%- if part == 'top' -%}
<script>
(() => { const root = document.getElementById('tme-gg-{{ section.id }}'); if (!root) return;
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const money = c => '$' + (c / 100).toFixed(2);
  const mv = () => { const q = root.querySelector('.tme-gg-quick'), f = document.querySelector('[data-ai-gift]'); if (q && f) f.before(q); }; // sit under the finder's heading, above its questions
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', mv) : mv();
  root.querySelectorAll('[data-gg-preset]').forEach(b => b.onclick = () => { let p = {}; try { p = JSON.parse(b.dataset.ggPreset); } catch(e){}
    document.dispatchEvent(new CustomEvent('tme-gift-preset', { detail: p })); });
  // Shared gift list from the app: ?gl=<base64url JSON {n: name, h: [product handles], x: [[series, "vols"]]}>
  const gl = new URLSearchParams(location.search).get('gl'); if (!gl) return; let L;
  try { const b64 = gl.replace(/-/g, '+').replace(/_/g, '/'); const bin = atob(b64 + '==='.slice((b64.length + 3) % 4)); L = JSON.parse(new TextDecoder().decode(Uint8Array.from(bin, c => c.charCodeAt(0)))); } catch(e){ return; }
  const box = root.querySelector('[data-gg-list]'); const hs = [...new Set((L.h || []).filter(h => typeof h === 'string' && /^[a-z0-9-]{1,200}$/.test(h)))].slice(0, 40);
  const who = String(L.n || '').trim().slice(0, 30); const whose = who ? esc(who) + '’s' : 'Their';
  box.hidden = false; box.innerHTML = `<h2>🎁 ${whose} manga gift list</h2><p class="tme-gg-sub">Loading what’s on our shelves…</p>`;
  Promise.all(hs.map(h => fetch('/products/' + h + '.js').then(r => r.ok ? r.json() : null).catch(() => null))).then(ps => {
    ps = ps.filter(Boolean); const avail = ps.filter(p => p.available), gone = ps.filter(p => !p.available);
    const loves = (Array.isArray(L.l) ? L.l : []).filter(x => typeof x === 'string').slice(0, 5).map(x => x.slice(0, 60));
    const vid = p => (p.variants.find(v => v.available) || p.variants[0]).id; const tot = avail.reduce((a, p) => a + p.price, 0);
    const other = (L.x || []).filter(x => Array.isArray(x) && x[0]).slice(0, 30).map(x => `${esc(String(x[0]).slice(0, 80))}${x[1] ? ' · Vol ' + esc(String(x[1]).slice(0, 60)) : ''}`);
    box.innerHTML = `<h2>🎁 ${whose} manga gift list</h2>
      <p class="tme-gg-sub">${avail.length ? `${avail.length} ${avail.length === 1 ? 'book they want is' : 'books they want are'} on our shelves right now. These are the exact volumes they’re missing, so no doubles!` : 'Nothing on this list is on our shelves right this minute. Try the gift finder below for something similar.'}</p>
      ${avail.length ? `<div class="tme-gg-lg">${avail.map(p => `<div class="tme-gg-li"><a href="/products/${encodeURIComponent(p.handle)}">${p.featured_image ? `<img src="${esc(p.featured_image)}" alt="" loading="lazy">` : ''}${esc(p.title)}</a><span><b>${money(p.price)}</b></span><button class="button button--secondary" type="button" data-gg-add="${vid(p)}">Add to cart</button></div>`).join('')}</div>
      <div class="tme-gg-tot">${avail.length > 1 ? `<button class="button" type="button" data-gg-all>Add all ${avail.length} to cart · ${money(tot)}</button>` : ''}<span>${tot >= 3500 ? '🚚 That ships free!' : `Add ${money(3500 - tot)} more for free shipping.`}</span></div>` : ''}
      ${loves.length ? `<div class="tme-gg-taste"><p>✨ <b>Want to surprise them with something new?</b> They love ${loves.map(esc).join(', ')}. Pick their age below and our gift finder will suggest books like those that aren't on their list.</p><button class="button button--secondary" type="button" data-gg-taste>✨ Find more they'd love</button></div>` : ''}
      ${gone.length || other.length ? `<details class="tme-gg-out"><summary>Also on their list (${gone.length + other.length}), not in stock right now</summary><ul>${gone.map(p => `<li>${esc(p.title)}</li>`).join('')}${other.map(o => `<li>${o}</li>`).join('')}</ul><p>We get new books in every week. <a href="/pages/contact">Ask us</a> and we’ll keep an eye out.</p></details>` : ''}`;
    const add = async (items, btn, label) => { btn.disabled = true; btn.textContent = 'Adding…';
      try { const r = await fetch('/cart/add.js', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify({ items }) }); if (!r.ok) throw 0;
        btn.outerHTML = `<a class="button" href="/cart">✓ ${label} · View cart</a>`; try { document.dispatchEvent(new CustomEvent('cart:refresh')); } catch(e){} }
      catch(e){ btn.disabled = false; btn.textContent = 'Sold out, sorry!'; } };
    box.addEventListener('click', e => { const one = e.target.closest('[data-gg-add]'); if (one) return add([{ id: +one.dataset.ggAdd, quantity: 1 }], one, 'Added');
      const all = e.target.closest('[data-gg-all]'); if (all) add(avail.map(p => ({ id: vid(p), quantity: 1 })), all, 'All added');
      if (e.target.closest('[data-gg-taste]')) document.dispatchEvent(new CustomEvent('tme-gift-preset', { detail: { likes: ('Loves ' + loves.join(', ') + '. Suggest something similar they probably don’t have yet.').slice(0, 300), newbie: false, chips: [], nosubmit: true } })); });
  }); })();
</script>
{%- endif -%}
{% schema %}
{ "name": "Gift guide", "settings": [
  { "type": "select", "id": "part", "label": "Part", "options": [{ "value": "top", "label": "Above the finder (gift list + quick start)" }, { "value": "bottom", "label": "Below the finder (ready-made gifts)" }], "default": "top" } ],
  "presets": [{ "name": "Gift guide" }] }
{% endschema %}
